# =============================================================================
# Delicut Support Analytics — environment config
# Copy to `.env.local` for secrets. Sync + Next load `.env` then `.env.local`
# (local overrides). Never commit real tokens.
# =============================================================================

# -----------------------------------------------------------------------------
# Freshchat API (required for sync)
# Used by: lib/freshchat/client.ts, extract jobs, /users/fetch enrichment
# -----------------------------------------------------------------------------
# Account API root from Admin → API settings (must be https://…/v2)
FRESHCHAT_API_BASE=https://your-domain.freshchat.com/v2
# Bearer token from Admin → Configure → API Tokens
FRESHCHAT_API_TOKEN=

# -----------------------------------------------------------------------------
# MongoDB (local warehouse)
# Used by: lib/db/client.ts — stores conversations/users/sync ledger as-is
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
# Database name (drop this DB to wipe analytics data)
MONGODB_DB=freshchat_analytics
# Max pooled connections from the Node process
MONGODB_MAX_POOL_SIZE=10
# Server selection / connect wait before failing (ms)
MONGODB_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Sync planning
# Used by: lib/sync/run.ts, planner, scripts/sync.ts
# -----------------------------------------------------------------------------
# First-run lookback when no cursor exists (days). Prefer --since= for year jobs.
SYNC_LOOKBACK_DAYS=30
# Re-fetch this many hours of “hot” transcripts so late messages aren’t missed
SYNC_TRANSCRIPT_OVERLAP_HOURS=24
# Re-fetch recent CSAT window (ratings often arrive late)
SYNC_CSAT_OVERLAP_DAYS=2
# Same overlap for Conversation-Resolution-Label
SYNC_LABEL_OVERLAP_DAYS=2
# Comma-separated Extract event names to pull each sync
SYNC_EVENTS=Chat-Transcript,CSAT-Score,Conversation-Resolution-Label,Conversation-Created,Conversation-Resolved,First-Response-Time,Resolution-Time

# -----------------------------------------------------------------------------
# Freshchat Extract API limits (account caps — don’t raise without checking plan)
# Used by: lib/freshchat/budget.ts, extract.ts
# -----------------------------------------------------------------------------
# Minimum wait between Extract POSTs (ms). Default 60000 = 1 job/min
EXTRACT_MIN_POST_INTERVAL_MS=60000
# Max Extract jobs per UTC day per event type
EXTRACT_MAX_JOBS_PER_DAY=120
# How often to poll job status while waiting (ms)
EXTRACT_POLL_INTERVAL_MS=20000
# Abort a stuck Extract job after this long (ms). Default ~75 min
EXTRACT_JOB_TIMEOUT_MS=4500000
# Local folder for downloaded ZIP/CSV caches
EXTRACT_CACHE_DIR=.cache/extracts

# -----------------------------------------------------------------------------
# HTTP client (Freshchat REST)
# Used by: lib/freshchat/client.ts
# -----------------------------------------------------------------------------
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_MS=1000
HTTP_BACKOFF_MAX_MS=60000
# Timeout for normal JSON API calls (ms)
HTTP_TIMEOUT_MS=60000
# Timeout for large Extract file downloads (ms)
HTTP_DOWNLOAD_TIMEOUT_MS=300000

# -----------------------------------------------------------------------------
# Mongo write / storage shaping
# Used by: merge scripts, transcript embed limits
# -----------------------------------------------------------------------------
# Conversations upserted per bulkWrite chunk
BULK_BATCH_SIZE=500
# Max messages kept inside one conversation document (truncates middle if over)
MAX_EMBEDDED_MESSAGES=500

# -----------------------------------------------------------------------------
# User enrichment (Freshchat /users/fetch — names/email/phone only)
# Used by: lib/sync/enrich-users.ts, lib/freshchat/users.ts
# -----------------------------------------------------------------------------
USER_FETCH_BATCH_SIZE=100
USER_ENRICH_MAX_PER_RUN=1000
# Re-fetch a user profile if last enrichment older than N days
USER_REFRESH_DAYS=30

# -----------------------------------------------------------------------------
# Optional keyword classification (off = Freshchat labels only, no invented subjects)
# Used by: lib/sync/classify-phase.ts, lib/classify/*
# -----------------------------------------------------------------------------
CLASSIFY_ENABLED=false
CLASSIFIER_VERSION=kw-v1
CLASSIFY_MESSAGE_WINDOW=5
CLASSIFY_MIN_SCORE=3
CLASSIFY_LLM_ENABLED=false

# -----------------------------------------------------------------------------
# Dashboard / UI product settings
# Used by: analytics pages, filters defaults, SyncStatusBadge, branding
# -----------------------------------------------------------------------------
# Shown in sidebar/header (product name)
APP_BRAND_NAME=Delicut
# Short product subtitle under the brand
APP_PRODUCT_NAME=Support Analytics
# Display label only — date filters/storage stay UTC calendar days
REPORTING_TIMEZONE=Asia/Dubai
# Badge “sync may be stale” after this many minutes without a completed run
SYNC_STALE_AFTER_MINUTES=60
# Default from/to window on dashboard & conversations when URL has no dates
DASHBOARD_DEFAULT_RANGE_DAYS=30
# Default rows per page for conversations/users lists (10|25|40|50|100)
UI_DEFAULT_PAGE_SIZE=25
# Max options returned by agent/customer/channel directory search APIs
DIRECTORY_SEARCH_LIMIT=40
# Messages per page when loading customer WhatsApp-style history
CUSTOMER_CHAT_PAGE_SIZE=50
# Cap rows in CSV export (sets X-Export-Truncated when hit)
EXPORT_CSV_MAX_ROWS=10000
# Optional: require Authorization: Bearer <secret> on /api/* (empty = open locally)
DASHBOARD_API_SECRET=

# -----------------------------------------------------------------------------
# Sync logging (console + files under LOG_DIR)
# Used by: lib/log/logger.ts, scripts/logs-prune.ts
# -----------------------------------------------------------------------------
LOG_TO_FILE=true
LOG_DIR=logs
LOG_RETENTION_DAYS=14
LOG_LEVEL=info
LOG_FORMAT=auto
