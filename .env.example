# =============================================================================
# Delicut Support Analytics — environment (lean)
#
# Required: Freshchat API + MongoDB.
# Everything else has defaults in lib/config.ts — only add a key here to override.
# Copy secrets to `.env.local` (gitignored). Load order: .env then .env.local.
# Full reference: docs/ENV.md
# =============================================================================

# --- Freshchat API (required for sync) ---
# Account API root (Admin → API settings). Must be https://…/v2
FRESHCHAT_API_BASE=https://your-domain.freshchat.com/v2
# Bearer token (Admin → Configure → API Tokens)
FRESHCHAT_API_TOKEN=

# --- MongoDB (local warehouse) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=freshchat_analytics

# --- Optional overrides ---
# Default UI timezone when URL has no ?tz= — Asia/Dubai | Asia/Kolkata | UTC
REPORTING_TIMEZONE=Asia/Dubai

# Uncomment to override further defaults from lib/config.ts:
# APP_BRAND_NAME=Delicut
# APP_PRODUCT_NAME=Support Analytics
# DASHBOARD_API_SECRET=
# CLASSIFY_ENABLED=false
# LOG_LEVEL=info
# LOG_TO_FILE=true
# SYNC_EVENTS=Chat-Transcript,CSAT-Score,Conversation-Resolution-Label,Conversation-Created,Conversation-Resolved,First-Response-Time,Resolution-Time
