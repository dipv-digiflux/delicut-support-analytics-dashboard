# Freshchat
# Account API root (Admin → API settings). Example: https://mercasto.freshchat.com/v2
FRESHCHAT_API_BASE=https://your-domain.freshchat.com/v2
# Admin → Configure → API Tokens (Bearer token)
FRESHCHAT_API_TOKEN=

# MongoDB — local warehouse (Freshchat data stored as-is)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=freshchat_analytics
MONGODB_MAX_POOL_SIZE=10
MONGODB_TIMEOUT_MS=10000

# Sync — first-run lookback if no cursor; prefer --since=YYYY-MM-DD for year backfill
SYNC_LOOKBACK_DAYS=30
SYNC_TRANSCRIPT_OVERLAP_HOURS=24
SYNC_CSAT_OVERLAP_DAYS=2
SYNC_LABEL_OVERLAP_DAYS=2
# Pull all useful Extract reports (comma-separated)
SYNC_EVENTS=Chat-Transcript,CSAT-Score,Conversation-Resolution-Label,Conversation-Created,Conversation-Resolved,First-Response-Time,Resolution-Time

# Extract API limits (Freshchat account caps — don't raise without checking plan)
EXTRACT_MIN_POST_INTERVAL_MS=60000
EXTRACT_MAX_JOBS_PER_DAY=120
EXTRACT_POLL_INTERVAL_MS=20000
EXTRACT_JOB_TIMEOUT_MS=4500000
EXTRACT_CACHE_DIR=.cache/extracts

# HTTP
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_MS=1000
HTTP_BACKOFF_MAX_MS=60000
HTTP_TIMEOUT_MS=60000
HTTP_DOWNLOAD_TIMEOUT_MS=300000

# Write batching
BULK_BATCH_SIZE=500
MAX_EMBEDDED_MESSAGES=500

# User enrichment from Freshchat /users/fetch only
USER_FETCH_BATCH_SIZE=100
USER_ENRICH_MAX_PER_RUN=1000
USER_REFRESH_DAYS=30

# Classification — keep false to use Freshchat labels only (no invented subjects)
CLASSIFY_ENABLED=false
CLASSIFIER_VERSION=kw-v1
CLASSIFY_MESSAGE_WINDOW=5
CLASSIFY_MIN_SCORE=3
CLASSIFY_LLM_ENABLED=false

# UI
REPORTING_TIMEZONE=Asia/Kolkata
SYNC_STALE_AFTER_MINUTES=60
# Optional: require Authorization: Bearer <secret> on /api/* (leave empty for local)
DASHBOARD_API_SECRET=

# Logging
LOG_TO_FILE=true
LOG_DIR=logs
LOG_RETENTION_DAYS=14
LOG_LEVEL=info
LOG_FORMAT=auto
