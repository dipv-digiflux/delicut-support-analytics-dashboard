# =============================================================================
# Delicut FreshChat Support Analytics
#
# Required: Freshchat API + MongoDB.
# Other tunables default in lib/config.ts — uncomment below to override.
# Copy to `.env.local` (gitignored). Load order: .env then .env.local (wins).
# See docs/ENV.md
# =============================================================================

# --- Freshchat API (required for sync) ---
# Account API root (Admin → API settings). Must be https://…/v2
FRESHCHAT_API_BASE=https://your-domain.freshchat.com/v2
# Bearer token (Admin → Configure → API Tokens)
FRESHCHAT_API_TOKEN=

# --- MongoDB (database name lives in the URI path — no separate MONGODB_DB) ---
MONGODB_URI=mongodb://127.0.0.1:27017/freshchat_analytics

# --- UI / reporting ---
# Default timezone when URL has no ?tz= — Asia/Dubai | Asia/Kolkata | UTC
REPORTING_TIMEZONE=Asia/Dubai

# --- Dashboard admin gate ---
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=admin

# --- Full data workbook (sidebar “Download all data”) ---
# HTTPS S3/CDN link to the xlsx/csv. Empty until you paste the uploaded file URL.
DATA_SHEET_URL=

# --- Optional overrides (defaults in lib/config.ts) ---
# APP_BRAND_NAME=Delicut
# APP_PRODUCT_NAME=FreshChat Support Analytics
# DASHBOARD_API_SECRET=
# DASHBOARD_SESSION_SECRET=
# CLASSIFY_ENABLED=false
# LOG_LEVEL=info
# LOG_TO_FILE=true
# SYNC_EVENTS=Chat-Transcript,CSAT-Score,Conversation-Resolution-Label,Conversation-Created,Conversation-Resolved,First-Response-Time,Resolution-Time
